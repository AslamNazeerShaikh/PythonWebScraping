# --- Search profile (edit to suit you) ---
KEYWORDS=asp.net core c# .net fullstack
LOCATIONS=pune,hyderabad
EXPERIENCE=6
DATE_FILTER=7
MAX_PAGES_PER_SEARCH=3
MAX_JOBS_TOTAL=60
ENRICH_DETAILS=true

# --- Browser / stealth ---
BROWSER=firefox
HEADLESS=false
SLOW_MO_MS=80
USER_DATA_DIR=.pw-profile
TIMEZONE=Asia/Kolkata
LOCALE=en-IN
VIEWPORT_W=1366
VIEWPORT_H=768

# --- uBlock Origin (Firefox XPI) ---
# Leave empty for built-in request-blocking fallback.
# To use real uBlock: download the .xpi from
# https://addons.mozilla.org/en-US/firefox/addon/ublock-origin/
# and set UBLOCK_XPI_PATH=/absolute/path/to/ublock_origin.xpi
UBLOCK_XPI_PATH=
UBLOCK_UNPACKED_DIR=
ADBLOCK_FALLBACK=true

# --- Politeness / anti-ban ---
MIN_DELAY_S=2.0
MAX_DELAY_S=5.0
NAV_TIMEOUT_MS=45000

# --- Output ---
OUTPUT_DIR=output

# --- Persistence / logging ---
DATABASE_URL=sqlite:///jobs.db
LOG_LEVEL=INFO
