# --- Search profile (edit to suit you) ---
KEYWORDS=asp.net core c# .net fullstack
LOCATIONS=pune,hyderabad
EXPERIENCE=6
DATE_FILTER=7
MAX_PAGES_PER_SEARCH=3
MAX_JOBS_TOTAL=60
ENRICH_DETAILS=true

# --- LinkedIn email collector (docs/SPEC-linkedin-email-collector.md) ---
# Target domains for `python -m src.main collect-emails` (comma-separated) when
# no --input-csv is given. CSV entries are "@domain:unique_email_target".
EMAIL_DOMAINS=cognizant.com,capgemini.com,ltm.com,hexaware.com,infosys.com,tcs.com,wipro.com,epam.com,kforce.com,persistent.com,xoriant.com
# Max mouse-wheel scroll rounds per domain (safety cap). The collector stops
# as soon as the domain's unique-email target is met.
EMAIL_MAX_SCROLLS=40
# Default unique-email target when a domain has no ":N" suffix in the CSV.
EMAIL_DEFAULT_TARGET=10
# Cooldown between domains (seconds). LinkedIn enforces a rolling search-rate
# limit; keep this generous (300 = 5 min) to avoid the "unusual search
# traffic" pause. Increase it if the wall appears after a couple of domains.
EMAIL_DOMAIN_PAUSE_S=300
# Only past-24h / past-week / past-month are valid — anything else is
# silently ignored by LinkedIn's search UI.
EMAIL_DATE_FACET=past-month

# --- Browser / stealth (Chrome-only stack) ---
BROWSER=chromium
HEADLESS=false
SLOW_MO_MS=80
USER_DATA_DIR=.pw-profile
TIMEZONE=Asia/Kolkata
LOCALE=en-IN
VIEWPORT_W=1366
VIEWPORT_H=768

# --- uBlock Origin Lite (unpacked MV3; fetch via vendor/download-ubol.sh) ---
# Loaded in headed mode only (headless-shell can't load extensions).
UBLOCK_UNPACKED_DIR=vendor/ubol-chrome
ADBLOCK_FALLBACK=true

# --- Politeness / anti-ban ---
MIN_DELAY_S=2.0
MAX_DELAY_S=5.0
NAV_TIMEOUT_MS=45000

# --- Output ---
OUTPUT_DIR=output

# --- Persistence / logging ---
DATABASE_URL=sqlite:///jobs.db
LOG_LEVEL=INFO

# --- Web control plane (`python -m src.main web`) ---
WEB_HOST=127.0.0.1
WEB_PORT=8000
LOG_DIR=logs

# --- GitHub MCP (opencode .opencode/opencode.json -> mcp.servers.github) ---
# Personal access token used as `Authorization: Bearer` header by the
# `github` remote MCP server (https://api.githubcopilot.com/mcp/).
# Never commit a real token - export it in your shell instead:
#   export GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...
GITHUB_PERSONAL_ACCESS_TOKEN=
